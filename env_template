# Environment Variables Template
# Fill in blanks "<<<>>>" with your credentials, then rename this file to ".env"

# AWS account credentials; also the default S3 source bucket for computer_vision
AWS_ACCESS_KEY_ID = "<<<>>>"
AWS_SECRET_ACCESS_KEY = "<<<>>>"
AWS_S3_REGION_NAME = "<<<>>>"
AWS_S3_BUCKET_NAME = "<<<>>>"

# SSH bastion fronting the databases. The only shared defaults: any domain below that
# does not set its own AWS_RDS_<DOMAIN>_SSH_* uses these. Omit to connect directly.
AWS_RDS_SSH_HOST = "<<<>>>"
AWS_RDS_SSH_PORT = "22"
AWS_RDS_SSH_USER = "<<<>>>"
AWS_RDS_SSH_PKEY = "~/.ssh/id_rsa"
AWS_RDS_SSH_PKEY_PASSWORD = "<<<>>>"

# Per-domain databases, read by the datascience_results routes. Each domain lives on
# its own server, so ENDPOINT / PORT / DB / USER_NAME / PASSWORD have NO shared
# fallback -- a domain is unconfigured unless its own variables are set, and its route
# returns 501 naming the ones missing.
AWS_RDS_BIOACOUSTICS_ENDPOINT = "<<<>>>"
AWS_RDS_BIOACOUSTICS_PORT = "5432"
AWS_RDS_BIOACOUSTICS_DB = "<<<>>>"
AWS_RDS_BIOACOUSTICS_USER_NAME = "<<<>>>"
AWS_RDS_BIOACOUSTICS_PASSWORD = "<<<>>>"

# multispectral and treetracker answer from a live S3 scan today (live_scan=true), so
